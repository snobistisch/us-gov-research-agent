# Required: model/provider selector. Change this one value to swap providers.
LLM_MODEL=openai-responses:gpt-5.6-luna

# Required for the default model. Create a paid key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=replace-with-your-own-openai-api-key

# Required for SEC requests, but not secret. Identify yourself with a real contact email.
SEC_USER_AGENT=Your Name your-email@example.com

# Free: one key from https://api.data.gov/signup/ works with Congress.gov,
# Regulations.gov, and GovInfo.
DATA_GOV_API_KEY=replace-with-your-free-api-data-gov-key

# Optional controls. Defaults are intentionally conservative.
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_MODEL_REQUESTS=6
AGENT_MAX_HTTP_REQUESTS=20
AGENT_MAX_INPUT_TOKENS=20000
AGENT_MAX_OUTPUT_TOKENS=10000
AGENT_MAX_RESPONSE_TOKENS=2000
